%% ============================================================
%% TryBe 统一账号体系 v2 · 类图
%% 来源：docs/auth-v2/02-架构设计.md
%% ============================================================

classDiagram
    class User {
        +Long id
        +String nickname
        +String avatar
        +String bio
        +Integer gender
        +UserStatus status
        +String role
        +String unionid "预留"
        +PhoneState phoneState
        +LocalDateTime createTime
        +LocalDateTime updateTime
    }
    class UserIdentity {
        +Long id
        +Long userId
        +IdentityType identityType
        +String appId
        +String identifier
        +Integer verified
        +LocalDateTime verifiedTime
    }
    class UserPassword {
        +Long userId
        +String passwordHash
    }
    class UserPhoneHistory {
        +Long id
        +Long userId
        +String phone
        +LocalDateTime boundTime
        +LocalDateTime releasedTime
        +String releaseReason
    }
    class PhoneTransferLog {
        +Long id
        +String transferNo
        +String phone
        +Long fromUserId
        +Long toUserId
        +String scene
    }
    class IdentityType {
        <<enum>>
        PHONE
        WECHAT_OPENID
    }
    class PhoneState {
        <<enum>>
        NEVER_BOUND "0"
        BOUND "1"
        RELEASED "2"
    }
    class SmsScene {
        <<enum>>
        LOGIN
        BIND
        REGISTER
    }

    class UserIdentityService {
        +Long resolveUserIdByIdentity(IdentityType, String appId, String identifier)
        +Long resolveCurrentPhoneOwner(String phone)
        +List~Long~ findReleasedOwners(String phone)
        +Long resolveUserIdByPhonePassword(String phone, String rawPassword)
        +String getCurrentPhone(Long userId)
        +void bindOrTransferInTx(Long userId, String phone)
    }
    class AuthFacadeService {
        +CaptchaVO generateCaptcha(String phone)
        +void sendSmsCode(SmsSendDTO dto, String clientIp)
        +CreatorLoginVO loginBySms(SmsLoginDTO dto, String clientIp)
        +CreatorLoginVO loginByPassword(PasswordLoginDTO dto, String clientIp)
        +PhoneBindVO bindPhone(Long userId, BindPhoneDTO dto)
    }
    class SmsCodeFacade {
        +void sendCode(String phone, String captchaId, String captchaCode, String clientIp, SmsScene scene)
        +void verifyCaptcha(String captchaId, String captchaCode, String phone)
        +void consumeCaptcha(String captchaId)
        +boolean verifySmsCode(String phone, String code)
    }
    class CaptchaStore {
        +CaptchaImage create(String phone)
        +void verify(String captchaId, String inputCode, String phone)
        +void markSent(String captchaId)
        +void consume(String captchaId)
    }
    class SmsRateLimiter {
        +void check(String phone, String clientIp)
        +String normalizeIp(String forwardedFor)
    }
    class SmsService {
        +void sendVerifyCode(String phone)
        +boolean verifyCode(String phone, String code)
    }
    class TokenIssuer {
        +TokenPair issue(Long userId, String openid)
    }
    class TokenPair {
        +String accessToken
        +String refreshToken
        +long expiresIn
    }
    class CreatorLoginVO {
        +Long userId
        +String nickname
        +String avatar
        +String phone
        +String role
        +String accessToken
        +String refreshToken
        +long expiresIn
        +PhoneState phoneState
    }
    class UserLoginVO {
        +Long userId
        +String nickname
        +String avatar
        +String phone
        +String openid
        +String role
        +String accessToken
        +String refreshToken
        +long expiresIn
        +PhoneState phoneState
    }

    User "1" --> "*" UserIdentity : 拥有凭据
    User "1" --> "0..1" UserPassword : 拥有密码
    User "1" --> "*" UserPhoneHistory : 曾绑手机号
    UserIdentityService ..> User : 读写
    UserIdentityService ..> UserIdentity : 读写
    UserIdentityService ..> UserPassword : 校验密码
    UserIdentityService ..> UserPhoneHistory : 释放历史
    UserIdentityService ..> PhoneTransferLog : 审计
    AuthFacadeService ..> SmsCodeFacade : 编排发码
    AuthFacadeService ..> UserIdentityService : 凭据解析/转移
    AuthFacadeService ..> TokenIssuer : 签发令牌
    AuthFacadeService ..> CreatorLoginVO : 构建
    SmsCodeFacade ..> CaptchaStore : 图形码
    SmsCodeFacade ..> SmsRateLimiter : 三级限流
    SmsCodeFacade ..> SmsService : 发码/校验
    TokenIssuer ..> TokenPair : 返回
