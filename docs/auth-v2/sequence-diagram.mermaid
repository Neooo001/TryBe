%% ============================================================
%% TryBe 统一账号体系 v2 · 时序图集（4 张）
%% 来源：docs/auth-v2/02-架构设计.md
%% 说明：标准 Mermaid sequenceDiagram，可直接粘贴到渲染器
%% ============================================================


%% ===== ① 小程序微信登录 + 强制绑号（含 60s / 图形码） =====
sequenceDiagram
    autonumber
    participant MP as 小程序(splash)
    participant WX as 微信服务器
    participant UC as UserController(/users/login)
    participant US as UserServiceImpl
    participant ID as UserIdentityService
    participant BP as 绑定页(BindPhone)
    participant AC as UserAuthController(/users/auth/**)
    participant FD as SmsCodeFacade
    participant SM as SmsService

    MP->>WX: wx.login()
    WX-->>MP: code
    MP->>UC: POST /users/login {code}
    UC->>US: loginByWechat(code)
    US->>WX: jscode2session(appid, secret, code)
    WX-->>US: openid
    US->>ID: resolveUserIdByIdentity(WECHAT_OPENID, appid, openid)
    alt 首次(无记录)
        US->>US: 建 user(phone_state=NEVER_BOUND) + WECHAT_OPENID 凭据
    end
    US->>US: TokenIssuer.issue(userId, openid)  %% nullToEmpty(openid)
    US-->>MP: UserLoginVO{..., phoneState}
    alt phoneState == NEVER_BOUND
        MP->>BP: reLaunch /pages/bind-phone?mode=force  %% 不可跳过
    else phoneState == RELEASED
        MP->>MP: 进入首页 + 顶部软提示横幅
    else BOUND
        MP->>MP: 进入首页
    end

    Note over BP,SM: 绑号页：图形码 + 60s 倒计时
    BP->>AC: POST /users/auth/captcha {phone?}
    AC-->>BP: {captchaId, imageBase64, expireSeconds}
    BP->>AC: POST /users/auth/sms/code {phone, captchaId, captchaCode}
    AC->>FD: sendCode(phone, captchaId, captchaCode, clientIp, BIND)
    FD->>FD: captchaStore.verify(...)   %% 失败5次作废
    FD->>FD: smsRateLimiter.check(phone, ip) %% 三级日限流
    FD->>SM: sendVerifyCode(phone)      %% 内含 60s 间隔
    SM-->>FD: ok
    FD->>FD: captchaStore.markSent(captchaId)
    AC-->>BP: R.ok()  %% 前端启动 60s 倒计时
    BP->>AC: POST /users/auth/phone/bind {phone, code}  %% 需登录(微信token)
    AC->>FD: verifySmsCode(phone, code)
    FD->>SM: verifyCode(phone, code)
    SM-->>FD: true
    AC->>ID: bindOrTransferInTx(userId, phone)  %% 见时序图②
    AC-->>BP: {phone, phoneState=BOUND}
    BP->>MP: 进入首页


%% ===== ② 手机号被占用时的归属转移（D3） =====
sequenceDiagram
    autonumber
    participant BP as 绑定方(B,小程序)
    participant AC as UserAuthController
    participant ID as UserIdentityService
    participant DB as MySQL(user/user_identity/...)
    participant LG as PhoneTransferLog

    BP->>AC: POST /users/auth/phone/bind {phone=P, code}
    Note over AC: 图形码已在发码阶段校验；此处校验短信码（短信=唯一裁决者）
    AC->>ID: bindOrTransferInTx(B, P)   %% @Transactional 纯DB
    ID->>DB: SELECT * FROM user_identity WHERE type=PHONE AND identifier=P FOR UPDATE
    alt 无占用者（P 空闲）
        ID->>DB: INSERT user_identity(B, PHONE, '', P, verified=1)
        ID->>DB: UPDATE user SET phone_state=1 WHERE id=B
        ID->>LG: INSERT transfer_log(from=NULL, to=B, phone=P)
    else 占用者 = B 本人（幂等）
        Note over ID: 直接返回成功，无任何写入
    else 占用者 = A（A≠B）
        ID->>DB: INSERT user_phone_history(A, P, released_time=now)  %% 记录历史手机号
        ID->>DB: DELETE user_identity WHERE type=PHONE AND identifier=P  %% 释放A
        ID->>DB: UPDATE user SET phone_state=2 WHERE id=A  %% A 待补绑
        ID->>DB: INSERT user_identity(B, PHONE, '', P, verified=1)  %% 可能撞唯一键
        ID->>DB: UPDATE user SET phone_state=1 WHERE id=B
        ID->>LG: INSERT transfer_log(from=A, to=B, phone=P)
    end
    Note over ID,DB: 并发失败方捕获 DuplicateKeyException → PHONE_OCCUPIED(可重试)
    ID-->>AC: 完成
    AC-->>BP: {phone=P, phoneState=BOUND}


%% ===== ③ A 的账号恢复路径（无 openid 的 Web 账号） =====
sequenceDiagram
    autonumber
    participant WU as Web用户(旧手机号P+密码)
    participant WP as Web登录页
    participant AC as UserAuthController(/users/auth/login/password)
    participant ID as UserIdentityService
    participant DB as MySQL
    participant BA as Web补绑页

    WU->>WP: 输入 P + 密码x + 图形码
    WP->>AC: POST /users/auth/login/password {phone=P, password=x, captchaId, captchaCode}
    AC->>AC: captchaStore.verify(...)
    AC->>ID: resolveUserIdByPhonePassword(P, x)
    ID->>DB: SELECT user_id FROM user_identity WHERE type=PHONE AND identifier=P  %% 当前持有者=B
    ID->>DB: SELECT user_id FROM user_phone_history WHERE phone=P ORDER BY released_time DESC  %% 历史持有者=A
    Note over ID: 候选=[B, A]；B 无密码跳过；A.user_password 校验 x 通过 → 命中 A
    ID-->>AC: matchedUserId = A（且 A ≠ 当前持有者 → 恢复匹配）
    AC->>AC: TokenIssuer.issue(A, openid=空)
    AC-->>WP: CreatorLoginVO{userId=A, phone=空, phoneState=RELEASED}
    WP->>BA: 路由守卫跳转 /bind-phone（恢复态强制补绑）
    WU->>BA: 输入新手机号 P2 + 图形码 + 短信码
    BA->>AC: POST /users/auth/phone/bind {phone=P2, code}
    AC->>ID: bindOrTransferInTx(A, P2)
    Note over ID: P2 未被占用 → 绑定给 A；A.phone_state=BOUND
    AC-->>BA: {phone=P2, phoneState=BOUND}
    BA-->>WU: 恢复完成，进入后台


%% ===== ④ Web 短信验证码登录（未注册自动注册，D2） =====
sequenceDiagram
    autonumber
    participant WU as Web用户
    participant WP as Web登录页(Tab:验证码登录)
    participant AC as UserAuthController(/users/auth/**)
    participant FD as SmsCodeFacade
    participant ID as UserIdentityService
    participant DB as MySQL
    participant SM as SmsService

    WU->>WP: 输入手机号
    WP->>AC: POST /users/auth/captcha {phone}
    AC-->>WP: {captchaId, imageBase64}
    WU->>WP: 填图形码 → 点「获取验证码」
    WP->>AC: POST /users/auth/sms/code {phone, captchaId, captchaCode}
    AC->>FD: sendCode(...)
    FD->>SM: sendVerifyCode(phone)   %% 60s 间隔
    AC-->>WP: R.ok()  %% 前端 60s 倒计时
    WU->>WP: 填短信码 → 点「登录」
    WP->>AC: POST /users/auth/login/sms {phone, code}   %% 不需图形码（短信码即强凭据）
    AC->>FD: verifySmsCode(phone, code)
    FD-->>AC: true
    AC->>ID: resolveCurrentPhoneOwner(phone)
    alt 手机号已注册(B)
        ID-->>AC: B
    else 手机号未注册（D2 自动注册）
        AC->>DB: INSERT user(role=USER, phone_state=BOUND)
        AC->>DB: INSERT user_identity(PHONE, '', phone, verified=1)
        Note over AC,DB: 捕获 DuplicateKeyException（并发注册兜底）
        ID-->>AC: 新 userId
    end
    AC->>AC: TokenIssuer.issue(userId, openid=空)
    AC-->>WP: CreatorLoginVO{..., phoneState=BOUND}
    WP->>WP: 按 role 路由（homePathByRole）
