<?xml version="1.0" encoding="UTF-8"?>
<!--
  trybe-avatar 桶 CORS 规则（开发联调用）

  用途：头像与主页封面图的浏览器直传 PUT。
  必要性：OSS 预签名 URL 只解决「授权写入」，不解决「跨域」。
          浏览器对非简单请求（PUT 且带自定义 Content-Type）会先发 OPTIONS 预检，
          桶侧不放行则预检被拒，PUT 根本发不出去。
          小程序端 wx.uploadFile 不受同源策略约束，所以此前一直没暴露该问题。

  字段含义、控制台填写方式、ossutil 应用命令与验证方法，见同目录 Nacos配置步骤.md 第 5 节。

  上线前务必把 AllowedOrigin 换成正式域名，不要保留通配。
-->
<CORSConfiguration>
  <CORSRule>
    <!-- 来源：本地 Vite dev server；端口会漂移故用端口通配。多行需逐条添加 -->
    <AllowedOrigin>http://localhost:*</AllowedOrigin>
    <AllowedOrigin>http://127.0.0.1:*</AllowedOrigin>
    <!-- 方法：PUT 是直传必需的，缺了就等于没配 -->
    <AllowedMethod>PUT</AllowedMethod>
    <AllowedMethod>GET</AllowedMethod>
    <AllowedMethod>HEAD</AllowedMethod>
    <AllowedMethod>POST</AllowedMethod>
    <!-- 允许的请求头：* 放行 Content-Type，否则预签名 PUT 被拒 -->
    <AllowedHeader>*</AllowedHeader>
    <!-- 暴露给前端的响应头：ETag 用于校验上传完整性 -->
    <ExposeHeader>ETag</ExposeHeader>
    <!-- 预检结果缓存时长，减少 OPTIONS 次数 -->
    <MaxAgeSeconds>3600</MaxAgeSeconds>
  </CORSRule>
</CORSConfiguration>
