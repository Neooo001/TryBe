<?xml version="1.0" encoding="UTF-8"?>
<!--
  trybe 桶（默认桶）CORS 规则（开发联调用）

  适用对象：默认桶 `trybe`，承载 物品主图 / 透明底素材 / 参考图 / 模特图 / 作品图片。
  对照组：trybe-avatar.xml 只覆盖头像与主页封面图所在的第二桶，两者互不生效。

  必要性：OSS 预签名 URL 只解决「授权写入」，不解决「跨域」。
          浏览器对 OSS 的 PUT 请求**必然会先发 OPTIONS 预检** ——
          PUT 方法在任何情况下都不属于 CORS「简单请求」，与是否携带
          Content-Type 无关。桶侧不放行则预检被拒，PUT 根本发不出去，
          浏览器控制台表现为 net::ERR_FAILED（不是 403，也不是 SignatureDoesNotMatch，
          所以极易被误判成签名或网络问题）。
          小程序端 wx.uploadFile 不受同源策略约束，故此前只在网页端上传才暴露。

  字段含义、控制台填写方式、ossutil 应用命令与验证方法，见同目录 Nacos配置步骤.md 第 5.1 节。

  上线前务必把 AllowedOrigin 换成正式域名，不要保留端口通配。
-->
<CORSConfiguration>
  <CORSRule>
    <!-- 来源：本地 Vite dev server；端口会漂移故用端口通配。多行需逐条添加 -->
    <AllowedOrigin>http://localhost:*</AllowedOrigin>
    <AllowedOrigin>http://127.0.0.1:*</AllowedOrigin>
    <!-- 方法：PUT 是直传必需的，缺了就等于没配 -->
    <AllowedMethod>PUT</AllowedMethod>
    <AllowedMethod>GET</AllowedMethod>
    <AllowedMethod>HEAD</AllowedMethod>
    <AllowedMethod>POST</AllowedMethod>
    <!-- 允许的请求头：* 放行 Content-Type，否则预签名 PUT 被拒 -->
    <AllowedHeader>*</AllowedHeader>
    <!-- 暴露给前端的响应头：ETag 用于校验上传完整性 -->
    <ExposeHeader>ETag</ExposeHeader>
    <!-- 预检结果缓存时长，减少 OPTIONS 次数 -->
    <MaxAgeSeconds>3600</MaxAgeSeconds>
  </CORSRule>
</CORSConfiguration>
